generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                        String                    @id @default(uuid())
  name                      String
  timezone                  String                    @default("Asia/Dhaka")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  attributes                Attribute[]
  attributeValues           AttributeValue[]
  auditLogs                 AuditLog[]
  bannerDesigns             BannerDesign[]
  branches                  Branch[]
  businessUnits             BusinessUnit[]
  categories                Category[]
  chartsOfAccounts          ChartOfAccounts[]
  customers                 Customer[]
  departments               Department[]
  documentSequences         DocumentSequence[]
  financeIntegrationConfigs FinanceIntegrationConfig?
  fiscalPeriods             FiscalPeriod[]
  inventoryMovements        InventoryMovement[]
  journalEntries            JournalEntry[]
  outboxEvents              OutboxEvent[]
  products                  Product[]
  productMedia              ProductMedia[]
  productVariants           ProductVariant[]
  variantBarcodes           ProductVariantBarcode[]
  projects                  Project[]
  purchases                 Purchase[]
  purchaseLines             PurchaseLine[]
  purchasePayments          PurchasePayment[]
  reviews                   Review[]
  roles                     Role[]
  sales                     Sale[]
  saleLines                 SaleLine[]
  salePayments              SalePayment[]
  stockBalances             StockBalance[]
  storefrontConfig          StorefrontConfig?
  suppliers                 Supplier[]
  units                     Unit[]
  users                     User[]
  variantAttributes         VariantAttribute[]
  warehouses                Warehouse[]
}

model BusinessUnit {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  type           String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branches       Branch[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
  journalLines   JournalLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Branch {
  id             String         @id @default(uuid())
  organizationId String
  businessUnitId String?
  code           String?
  name           String
  location       String?
  phone          String?
  email          String?
  timezone       String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bannerDesigns  BannerDesign[]
  businessUnit   BusinessUnit?  @relation(fields: [organizationId, businessUnitId], references: [organizationId, id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  journalLines   JournalLine[]
  purchases      Purchase[]
  sales          Sale[]
  warehouses     Warehouse[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model Warehouse {
  id                 String              @id @default(uuid())
  organizationId     String
  branchId           String
  name               String
  code               String?
  address            String?
  isActive           Boolean             @default(true)
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  sales              Sale[]
  stockBalances      StockBalance[]
  branch             Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id])
  organization       Organization        @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([branchId])
}

model Department {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  journalLines   JournalLine[]

  @@unique([organizationId, name])
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  businessUnitId String?
  name           String
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journalLines   JournalLine[]
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model User {
  id                    String              @id @default(uuid())
  organizationId        String
  email                 String              @unique
  password              String
  firstName             String
  lastName              String
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  auditLogs             AuditLog[]
  inventoryMovements    InventoryMovement[]
  createdJournalEntries JournalEntry[]      @relation("CreatedByUser")
  postedJournalEntries  JournalEntry[]      @relation("PostedByUser")
  sales                 Sale[]
  organization          Organization        @relation(fields: [organizationId], references: [id])
  userRoles             UserRole[]
}

model Role {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, name])
}

/// Permissions are global system-defined action strings.
/// They are NOT organization-scoped because they represent system capabilities,
/// not business data. Organizations customize access by assigning permissions to roles.
model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model ChartOfAccounts {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model Account {
  id                String          @id @default(uuid())
  chartOfAccountsId String
  code              String
  name              String
  type              AccountType
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  chartOfAccounts   ChartOfAccounts @relation(fields: [chartOfAccountsId], references: [id])
  journalLines      JournalLine[]

  @@unique([chartOfAccountsId, code])
  @@index([chartOfAccountsId, type])
}

model FiscalPeriod {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus   @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  journalEntries JournalEntry[]
  sales          Sale[]

  @@unique([organizationId, name])
  @@unique([organizationId, startDate])
}

model JournalEntry {
  id              String         @id @default(uuid())
  organizationId  String
  fiscalPeriodId  String?
  accountingDate  DateTime
  referenceType   String?
  referenceId     String?
  idempotencyKey  String?
  status          EntryStatus    @default(DRAFT)
  description     String?
  reversalOfId    String?
  createdByUserId String?
  postedByUserId  String?
  postedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       User?          @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  fiscalPeriod    FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  organization    Organization   @relation(fields: [organizationId], references: [id])
  postedBy        User?          @relation("PostedByUser", fields: [postedByUserId], references: [id])
  reversalOf      JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfId], references: [id])
  reversals       JournalEntry[] @relation("JournalEntryReversal")
  lines           JournalLine[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, accountingDate])
  @@index([organizationId, status])
  @@index([referenceType, referenceId])
}

/// JournalLine is INSERT-ONLY. No updates, no deletes.
/// Each line carries exactly one positive amount in debit OR credit, never both.
/// This is enforced by:
/// 1. Application-layer validation in the Finance Service.
/// 2. A raw SQL CHECK constraint added in the initial migration:
/// CHECK (debit >= 0 AND credit >= 0 AND (debit = 0 OR credit = 0) AND (debit + credit > 0))
model JournalLine {
  id             String        @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal       @default(0) @db.Decimal(19, 4)
  credit         Decimal       @default(0) @db.Decimal(19, 4)
  businessUnitId String?
  branchId       String?
  departmentId   String?
  projectId      String?
  createdAt      DateTime      @default(now())
  account        Account       @relation(fields: [accountId], references: [id])
  branch         Branch?       @relation(fields: [branchId], references: [id])
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])

  @@index([accountId, journalEntryId])
  @@index([businessUnitId])
  @@index([branchId])
  @@index([departmentId])
  @@index([projectId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  entityType     String
  entityId       String
  action         String
  oldData        Json?
  newData        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, userId])
  @@index([organizationId, createdAt])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  code           String?
  name           String
  phone          String?
  email          String?
  address        String?
  password       String?
  status         String       @default("ACTIVE")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  avatarUrl      String?
  city           String?
  companyName    String?
  country        String?
  customerType   String       @default("INDIVIDUAL")
  taxId          String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  sales          Sale[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  code           String?
  name           String
  phone          String?
  email          String?
  address        String?
  status         String       @default("ACTIVE")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Unit {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  abbreviation   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  imageUrl       String?
  type           ProductType  @default(PRODUCT)
  organization   Organization @relation(fields: [organizationId], references: [id])
  parent         Category?    @relation("CategoryHierarchy", fields: [organizationId, parentId], references: [organizationId, id])
  children       Category[]   @relation("CategoryHierarchy")
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model Product {
  id              String           @id @default(uuid())
  organizationId  String
  categoryId      String?
  unitId          String?
  type            ProductType      @default(PRODUCT)
  code            String?
  name            String
  description     String?
  imageUrl        String?
  sellingPrice    Decimal          @default(0) @db.Decimal(19, 4)
  costPrice       Decimal?         @db.Decimal(19, 4)
  isActive        Boolean          @default(true)
  displayOrder    Int              @default(0)
  status          ProductStatus    @default(DRAFT)
  isOnlineVisible Boolean          @default(false)
  isPosVisible    Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  compareAtPrice  Decimal?         @db.Decimal(19, 4)
  category        Category?        @relation(fields: [organizationId, categoryId], references: [organizationId, id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  unit            Unit?            @relation(fields: [organizationId, unitId], references: [organizationId, id])
  media           ProductMedia[]
  variants        ProductVariant[]
  reviews         Review[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model OutboxEvent {
  id                  String       @id @default(uuid())
  organizationId      String
  eventType           String
  aggregateType       String
  aggregateId         String
  payload             Json
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  availableAt         DateTime     @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastError           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id])

  @@index([status, availableAt])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([organizationId, eventType])
}

model FinanceIntegrationConfig {
  organizationId              String       @id
  cashAccountId               String?
  bankAccountId               String?
  mobileBankingAccountId      String?
  salesRevenueAccountId       String?
  serviceRevenueAccountId     String?
  accountsReceivableAccountId String?
  accountsPayableAccountId    String?
  inventoryAssetAccountId     String?
  organization                Organization @relation(fields: [organizationId], references: [id])
}

/// The authoritative source of truth for inventory. Immutable.
model InventoryMovement {
  id              String         @id @default(uuid())
  organizationId  String
  warehouseId     String
  variantId       String         @default("var-123")
  type            MovementType
  quantity        Decimal        @db.Decimal(19, 4)
  unitCost        Decimal?       @db.Decimal(19, 4)
  serialNumber    String?
  movementDate    DateTime       @default(now())
  referenceType   String?
  referenceId     String?
  idempotencyKey  String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  createdBy       User?          @relation(fields: [createdByUserId], references: [id])
  organization    Organization   @relation(fields: [organizationId], references: [id])
  variant         ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])
  warehouse       Warehouse      @relation(fields: [organizationId, warehouseId], references: [organizationId, id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, warehouseId, variantId])
  @@index([organizationId, movementDate])
  @@index([referenceType, referenceId])
}

/// Derived projection of current stock. Updated strictly via movements.
model StockBalance {
  id             String         @id @default(uuid())
  organizationId String
  warehouseId    String
  variantId      String         @default("var-123")
  quantity       Decimal        @default(0) @db.Decimal(19, 4)
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])
  warehouse      Warehouse      @relation(fields: [organizationId, warehouseId], references: [organizationId, id])

  @@unique([organizationId, warehouseId, variantId])
}

model DocumentSequence {
  id             String       @id @default(uuid())
  organizationId String
  prefix         String
  year           Int
  nextSequence   Int          @default(1)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, prefix, year])
}

model Sale {
  id              String        @id @default(uuid())
  organizationId  String
  branchId        String
  warehouseId     String
  customerId      String?
  status          SaleStatus    @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)
  saleNumber      String?
  subtotal        Decimal       @default(0) @db.Decimal(19, 4)
  discount        Decimal       @default(0) @db.Decimal(19, 4)
  total           Decimal       @default(0) @db.Decimal(19, 4)
  saleDate        DateTime      @default(now())
  idempotencyKey  String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  fiscalPeriodId  String?
  createdBy       User?         @relation(fields: [createdByUserId], references: [id])
  fiscalPeriod    FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  branch          Branch        @relation(fields: [organizationId, branchId], references: [organizationId, id])
  customer        Customer?     @relation(fields: [organizationId, customerId], references: [organizationId, id])
  organization    Organization  @relation(fields: [organizationId], references: [id])
  warehouse       Warehouse     @relation(fields: [organizationId, warehouseId], references: [organizationId, id])
  lines           SaleLine[]
  payments        SalePayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, saleNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, saleDate])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
}

model SaleLine {
  id                  String         @id @default(uuid())
  organizationId      String         @default("org-123")
  saleId              String
  variantId           String         @default("var-123")
  quantity            Decimal        @db.Decimal(19, 4)
  unitPrice           Decimal        @db.Decimal(19, 4)
  discount            Decimal        @default(0) @db.Decimal(19, 4)
  lineSubtotal        Decimal        @db.Decimal(19, 4)
  lineTotal           Decimal        @db.Decimal(19, 4)
  productNameSnapshot String         @default("")
  skuSnapshot         String         @default("")
  organization        Organization   @relation(fields: [organizationId], references: [id])
  sale                Sale           @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])
}

model SalePayment {
  id             String        @id @default(uuid())
  organizationId String
  saleId         String
  amount         Decimal       @db.Decimal(19, 4)
  method         PaymentMethod
  reference      String?
  paymentDate    DateTime      @default(now())
  idempotencyKey String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  sale           Sale          @relation(fields: [saleId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, saleId])
  @@index([organizationId, paymentDate])
}

model BannerDesign {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  type           String
  width          Decimal      @db.Decimal(10, 2)
  height         Decimal      @db.Decimal(10, 2)
  unit           String
  template       String
  settings       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branch         Branch?      @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([branchId])
}

model ProductVariant {
  id                 String                  @id @default(uuid())
  organizationId     String
  productId          String
  sku                String
  costPrice          Decimal?                @db.Decimal(19, 4)
  retailPrice        Decimal                 @default(0) @db.Decimal(19, 4)
  posPrice           Decimal?                @db.Decimal(19, 4)
  trackingType       TrackingType            @default(NONE)
  status             ProductStatus           @default(ACTIVE)
  attributeHash      String                  @default("")
  isOnlineVisible    Boolean?
  isPosVisible       Boolean?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  inventoryMovements InventoryMovement[]
  media              ProductMedia[]
  organization       Organization            @relation(fields: [organizationId], references: [id])
  product            Product                 @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  barcodes           ProductVariantBarcode[]
  purchaseLines      PurchaseLine[]
  saleLines          SaleLine[]
  stockBalances      StockBalance[]
  attributes         VariantAttribute[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([productId, attributeHash])
}

model ProductVariantBarcode {
  id             String         @id @default(uuid())
  organizationId String
  variantId      String
  barcode        String
  isActive       Boolean        @default(true)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  variant        ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, barcode])
}

model Attribute {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  values         AttributeValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model AttributeValue {
  id             String             @id @default(uuid())
  organizationId String
  attributeId    String
  value          String
  attribute      Attribute          @relation(fields: [organizationId, attributeId], references: [organizationId, id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id])
  variants       VariantAttribute[]

  @@unique([organizationId, id])
  @@unique([organizationId, attributeId, value])
}

model VariantAttribute {
  organizationId   String
  variantId        String
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [organizationId, attributeValueId], references: [organizationId, id])
  organization     Organization   @relation(fields: [organizationId], references: [id])
  variant          ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model ProductMedia {
  id             String          @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  url            String
  type           MediaType       @default(IMAGE)
  displayOrder   Int             @default(0)
  isPrimary      Boolean         @default(false)
  organization   Organization    @relation(fields: [organizationId], references: [id])
  product        Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [organizationId, variantId], references: [organizationId, id], onDelete: Cascade)
}

model Purchase {
  id             String            @id @default(uuid())
  organizationId String
  supplierId     String
  branchId       String?
  warehouseId    String
  status         PurchaseStatus    @default(DRAFT)
  purchaseDate   DateTime
  subtotal       Decimal           @default(0) @db.Decimal(19, 4)
  totalDiscount  Decimal           @default(0) @db.Decimal(19, 4)
  total          Decimal           @default(0) @db.Decimal(19, 4)
  idempotencyKey String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  branch         Branch?           @relation(fields: [organizationId, branchId], references: [organizationId, id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  supplier       Supplier          @relation(fields: [organizationId, supplierId], references: [organizationId, id])
  warehouse      Warehouse         @relation(fields: [organizationId, warehouseId], references: [organizationId, id])
  lines          PurchaseLine[]
  payments       PurchasePayment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, purchaseDate])
  @@index([organizationId, status])
}

model PurchaseLine {
  id                  String         @id @default(uuid())
  organizationId      String
  purchaseId          String
  variantId           String
  quantity            Decimal        @db.Decimal(19, 4)
  unitCost            Decimal        @db.Decimal(19, 4)
  discount            Decimal        @default(0) @db.Decimal(19, 4)
  lineSubtotal        Decimal        @db.Decimal(19, 4)
  lineTotal           Decimal        @db.Decimal(19, 4)
  productNameSnapshot String
  skuSnapshot         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organization        Organization   @relation(fields: [organizationId], references: [id])
  variant             ProductVariant @relation(fields: [organizationId, variantId], references: [organizationId, id])
  purchase            Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model PurchasePayment {
  id             String        @id @default(uuid())
  organizationId String
  purchaseId     String
  amount         Decimal       @db.Decimal(19, 4)
  method         PaymentMethod
  reference      String?
  paymentDate    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model StorefrontConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  heroSlides     Json?
  flashSaleEnd   DateTime?
  promoBanner    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  serviceSlides  Json?
  globalSettings Json?
  homepageData   Json?
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Review {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  rating         Int
  comment        String?
  authorName     String
  authorImage    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId])
}

