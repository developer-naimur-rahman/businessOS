# ============================================
# Business Operating System - Environment Config
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/business_os?schema=public"

# Authentication
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
JWT_EXPIRATION="1d"

# Server
PORT=3000
NODE_ENV=development

# Timezone
# All timestamps are stored as UTC in the database.
# This value is used for business-level date display and reporting.
TZ=UTC
BUSINESS_TIMEZONE="Asia/Dhaka"
